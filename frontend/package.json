{
  "name": "sheetops-console",
  "version": "0.1.0",
  "private": true,
  "description": "SheetOps operator console: read-only, offline first milestone",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "data": "node scripts/generate-demo-data.cjs",
    "data:check": "node scripts/generate-demo-data.cjs --check",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/public-sans": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
